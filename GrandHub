local function getLvl()
    local d = player:FindFirstChild("Data")
    if d and d:FindFirstChild("Level") then return d.Level.Value end
    return 1
end

local function getQuest(lv)
    local q = quests[1]
    for _, v in ipairs(quests) do
        if v.L <= lv then q = v else break end
    end
    return q
end

local function acharInimigo(nome)
    local ch = player.Character
    if not ch or not ch:FindFirstChild("HumanoidRootPart") then return nil end
    local pos = ch.HumanoidRootPart.Position
    local best, bd = nil, math.huge
    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("Model") and o.Name:lower():find(nome:lower(), 1, true) then
            local hrp = o:FindFirstChild("HumanoidRootPart")
            local hum = o:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - pos).Magnitude
                if d < bd then bd = d; best = o end
            end
        end
    end
    return best
end

-- ============ LOOP FARM ============
local function loopFarm()
    while autoFarmOn do
        local ch = player.Character
        if ch and ch:FindFirstChild("HumanoidRootPart") then
            local lv = getLvl()
            local q = getQuest(lv)
            if not missaoAtual or missaoAtual.L ~= q.L then
                missaoAtual = q
                killCount = 0
            end
            -- Loop persistente: só sai quando achar
            local alvo = acharInimigo(q.M)
            if alvo and alvo:FindFirstChild("HumanoidRootPart") then
                local hrp = alvo.HumanoidRootPart
                local hum = alvo:FindFirstChildOfClass("Humanoid")
                local myHRP = ch.HumanoidRootPart
                myHRP.CFrame = CFrame.new(myHRP.Position:Lerp(hrp.Position + Vector3.new(0, 0, 3), 0.2))
                if hum and hum.Health > 0 then
                    local t = ch:FindFirstChildOfClass("Tool")
                    if t then pcall(function() t:Activate() end) end
                    statusFarm.Text = string.format("  Nv %d | %s | HP %d | Kills %d",
                        lv, q.M, math.floor(hum.Health), killCount)
                else
                    killCount = killCount + 1
                end
            else
                statusFarm.Text = string.format("  Nv %d | Procurando %s...", lv, q.M)
            end
        end
        task.wait(0.1)
    end
    statusFarm.Text = "  Parado"
end

-- ============ LOOP FRUIT ============
local function temBeli()
    local d = player:FindFirstChild("Data")
    if d and d:FindFirstChild("Beli") then return d.Beli.Value >= 1000000 end
    return false
end

local function acharFruta()
    local ch = player.Character
    if not ch or not ch:FindFirstChild("HumanoidRootPart") then return nil end
    local best, bd = nil, math.huge
    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("Model") and (o.Name:lower():find("fruit") or o:FindFirstChild("Fruit")) then
            local hrp = o:FindFirstChild("HumanoidRootPart") or o:FindFirstChild("Handle")
            if hrp then
                local d = (hrp.Position - ch.HumanoidRootPart.Position).Magnitude
                if d < bd then bd = d; best = o end
            end
        end
    end
    return best
end

local function loopFruit()
    while autoFruitOn do
        local ch = player.Character
        if ch and ch:FindFirstChild("HumanoidRootPart") then
            if not temBeli() then
                statusFruit.Text = "  Beli insuficiente (1M+)"
                task.wait(2)
            else
                local f = acharFruta()
                if f then
                    statusFruit.Text = "  Coletando: " .. f.Name
                    local wasFarm = autoFarmOn
                    autoFarmOn = false
                    task.wait(0.5)
                    local hrpF = f:FindFirstChild("HumanoidRootPart") or f:FindFirstChild("Handle")
                    if hrpF then
                        local dist = (hrpF.Position - ch.HumanoidRootPart.Position).Magnitude
                        local tw = TweenService:Create(ch.HumanoidRootPart,
                            TweenInfo.new(dist / 80, Enum.EasingStyle.Linear),
                            {CFrame = CFrame.new(hrpF.Position)})
                        tw:Play()
                        tw.Completed:Wait()
                    end
                    pcall(function()
                        RS.Remotes.CommF_:InvokeServer("StoreFruit", f.Name)
                    end)
                    task.wait(1)
                    statusFruit.Text = "  Armazenada: " .. f.Name
                    if wasFarm then
                        autoFarmOn = true
                        task.spawn(loopFarm)
                    end
                else
                    statusFruit.Text = "  Procurando frutas..."
                end
            end
        end
        task.wait(1)
    end
    statusFruit.Text = "  Aguardando..."
end

-- ============ LOOP UNLOCK ============
local function loopUnlock()
    while autoUnlockOn do
        local lv = getLvl()
        local sea = "First"
        if game.PlaceId == 4442272183 then sea = "Second"
        elseif game.PlaceId == 7449423635 then sea = "Third" end
        if sea == "First" and lv >= 700 then
            statusUnlock.Text = "  Desbloqueando Second Sea..."
            pcall(function() RS.Remotes.CommF_:InvokeServer("Military Detective") end)
            task.wait(2)
            pcall(function() RS.Remotes.CommF_:InvokeServer("StartQuest", "IceAdmiral", 1) end)
            task.wait(2)
            statusUnlock.Text = "  Derrotando Ice Admiral..."
            for i = 1, 30 do
                local b = acharInimigo("Ice Admiral")
                if b then
                    local ch = player.Character
                    if ch and ch:FindFirstChild("HumanoidRootPart") then
                        ch.HumanoidRootPart.CFrame = b.HumanoidRootPart.CFrame + Vector3.new(0, 0, 3)
                        local t = ch:FindFirstChildOfClass("Tool")
                        if t then pcall(function() t:Activate() end) end
                    end
                end
                task.wait(1)
            end
            pcall(function() RS.Remotes.CommF_:InvokeServer("Military Detective") end)
            task.wait(2)
            pcall(function() RS.Remotes.CommF_:InvokeServer("Experienced Captain") end)
            task.wait(3)
            statusUnlock.Text = "  Second Sea desbloqueado!"
        elseif sea == "Second" and lv >= 1500 then
            statusUnlock.Text = "  Desbloqueando Third Sea..."
            pcall(function() RS.Remotes.CommF_:InvokeServer("King Red Head") end)
            task.wait(2)
            pcall(function() RS.Remotes.CommF_:InvokeServer("Mr. Captain") end)
            task.wait(3)
            statusUnlock.Text = "  Third Sea desbloqueado!"
        elseif sea == "Third" then
            statusUnlock.Text = "  Você já está no Third Sea"
        else
            statusUnlock.Text = string.format("  Nv %d | Farme até o requisito", lv)
        end
        task.wait(5)
    end
    statusUnlock.Text = "  Aguardando..."
end

